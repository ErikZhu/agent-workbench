# ── Local paths ────────────────────────────────────────────────────────────
# Point these to wherever your .claude directory lives
AGENTS_DIR=~/.claude/agents
MEMORY_DIR=~/.claude/agent-memory
SKILLS_DIR=~/.claude/skills

# ── API server ─────────────────────────────────────────────────────────────
PORT=3001
HOOK_SERVER=http://127.0.0.1:7860

# ── Storage adapter ────────────────────────────────────────────────────────
# "local"  → reads from local filesystem (default, works on any Mac/Linux)
# "remote" → reads from a remote API server (for cloud/VPS migration)
#            requires REMOTE_API_BASE to be set
STORAGE_ADAPTER=local
# REMOTE_API_BASE=https://your-remote-server.com

# ── Migration checklist ────────────────────────────────────────────────────
# To migrate to a remote server:
# 1. Deploy server/index.js on a VPS/cloud (e.g. Railway, Render, Fly.io)
# 2. Sync your ~/.claude/ directory to the server (rsync or object storage)
# 3. Set STORAGE_ADAPTER=remote and REMOTE_API_BASE=<your server URL>
# 4. Update HOOK_SERVER if claude-watch bridge moves too
# 5. Point frontend VITE_API_BASE to the new server
